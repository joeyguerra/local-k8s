#!/usr/bin/env bash
# Permanent k3d shim — replaces k3d after migrating from k3d to Lima k3s.
#
# Add ~/src/local-k8s/bin to the front of PATH in ~/.zshrc:
#   export PATH="$HOME/src/local-k8s/bin:$PATH"
#
# Only 'k3d image import <image> -c <cluster>' is intercepted.
# All other k3d sub-commands succeed silently so existing scripts don't break.

set -euo pipefail

LIMA_INSTANCE="${LIMA_INSTANCE:-k3s}"

if [[ "${1:-}" == "image" && "${2:-}" == "import" ]]; then
  IMAGE="${3:-}"
  if [ -z "$IMAGE" ]; then
    echo "k3d shim: no image specified" >&2
    exit 1
  fi
  echo "k3d shim: importing $IMAGE → Lima k3s ($LIMA_INSTANCE)"
  docker save "$IMAGE" | limactl shell "$LIMA_INSTANCE" -- sudo k3s ctr images import -
  echo "k3d shim: ✓ $IMAGE imported"
  exit 0
fi

# Any other k3d command: succeed silently
echo "k3d shim: ignoring 'k3d $*'" >&2
exit 0
